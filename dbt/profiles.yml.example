aerologix:
  target: dev
  outputs:
    dev:
      type: sqlserver
      driver: "ODBC Driver 18 for SQL Server"
      server: "{{ env_var('SQLSERVER_HOST', 'localhost') }}"
      port: "{{ env_var('SQLSERVER_PORT', '1433') | int }}"
      database: "{{ env_var('SQLSERVER_DATABASE', 'AeroLogix') }}"
      schema: dbo
      user: "{{ env_var('SQLSERVER_USER', 'sa') }}"
      password: "{{ env_var('SQLSERVER_PASSWORD') }}"
      trust_cert: true
